# Copy to .env (never commit .env) and fill in.
# From inside a container, a SQL Server on your PC is host.docker.internal, not localhost.
SQL_CONNECTION_STRING=Server=host.docker.internal,1433;Database=RaceDayDb;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True;
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=YOUR_ACCOUNT;AccountKey=YOUR_KEY;EndpointSuffix=core.windows.net
