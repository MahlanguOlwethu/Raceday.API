# Copy this file to .env (never commit .env) and fill in your own values.
# docker-compose.yml reads it automatically.

# Password for the SQL Server container (min 8 chars, upper + lower + digit + symbol)
SA_PASSWORD=Change.Me.123

# Azure Storage account connection string (Azure portal > Storage account > Access keys)
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=YOUR_ACCOUNT;AccountKey=YOUR_KEY;EndpointSuffix=core.windows.net
