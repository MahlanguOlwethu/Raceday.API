@model IEnumerable<System.Text.Json.JsonElement>
@{
    ViewData["Title"] = "My Enrolments";
}

<h2 class="mb-4">My Enrolments</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">You haven't enrolled in any events yet. <a asp-controller="Events" asp-action="Index">Browse Events</a></div>
}
else
{
    <table class="table table-striped shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Event</th>
                <th>Date</th>
                <th>Category</th>
                <th>Enrolment Date</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                var status = item.GetProperty("status").GetString();
                var badgeColor = status == "Confirmed" ? "bg-success" : (status == "Cancelled" ? "bg-danger" : "bg-warning text-dark");

                <tr>
                    <td>@item.GetProperty("eventName").GetString()</td>
                    <td>@item.GetProperty("eventDate").GetDateTime().ToString("dd MMM yyyy")</td>
                    <td>@item.GetProperty("categoryName").GetString()</td>
                    <td>@item.GetProperty("enrolmentDate").GetDateTime().ToString("dd MMM yyyy")</td>
                    <td><span class="badge @badgeColor">@status</span></td>
                </tr>
            }
        </tbody>
    </table>
}