@model IEnumerable<System.Text.Json.JsonElement>
@{
    ViewData["Title"] = "Manage Enrolments";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Manage Enrolments</h2>
    <a asp-controller="Events" asp-action="MyEvents" class="btn btn-outline-secondary">Back to My Events</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">No participants have enrolled in this event yet.</div>
}
else
{
    <div class="table-responsive shadow-sm">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Participant</th>
                    <th>Email</th>
                    <th>Category</th>
                    <th>Date Enrolled</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var enrolmentId = item.GetProperty("enrolmentId").GetInt32();
                    var status = item.GetProperty("status").GetString();
                    var badgeColor = status == "Confirmed" ? "bg-success" : (status == "Cancelled" ? "bg-danger" : "bg-warning text-dark");

                    <tr>
                        <td class="fw-bold">@item.GetProperty("participantName").GetString()</td>
                        <td>@item.GetProperty("participantEmail").GetString()</td>
                        <td>@item.GetProperty("categoryName").GetString()</td>
                        <td>@item.GetProperty("enrolmentDate").GetDateTime().ToString("dd MMM yyyy")</td>
                        <td><span class="badge @badgeColor px-3 py-2">@status</span></td>
                        <td class="text-end">
                            @if (status != "Confirmed")
                            {
                                <form asp-action="UpdateStatus" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@enrolmentId" />
                                    <input type="hidden" name="status" value="Confirmed" />
                                    <input type="hidden" name="eventId" value="@ViewBag.EventId" />
                                    <button type="submit" class="btn btn-sm btn-success">Approve</button>
                                </form>
                            }

                            @if (status != "Cancelled")
                            {
                                <form asp-action="UpdateStatus" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@enrolmentId" />
                                    <input type="hidden" name="status" value="Cancelled" />
                                    <input type="hidden" name="eventId" value="@ViewBag.EventId" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Reject</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}