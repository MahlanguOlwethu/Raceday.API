@model IEnumerable<RaceDay.MVC.ViewModels.EventViewModel>
@{
    ViewData["Title"] = "My Events";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>My Events</h2>
    <a asp-action="Create" class="btn btn-primary">➕ Create New Event</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">You haven't created any events yet.</div>
}
else
{
    <div class="table-responsive shadow-sm">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Banner</th>
                    <th>Event Name</th>
                    <th>Date</th>
                    <th>Location</th>
                    <th>Categories</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ev in Model)
                {
                    <tr>
                        <td style="width: 90px;">
                            @if (!string.IsNullOrEmpty(ev.BannerImageUrl))
                            {
                                <img src="@ev.BannerImageUrl" alt="@ev.Name banner" class="rounded" style="width: 80px; height: 48px; object-fit: cover;" />
                            }
                            else
                            {
                                <span class="text-muted small">No banner</span>
                            }
                        </td>
                        <td class="fw-bold">@ev.Name</td>
                        <td>@ev.EventDate.ToString("dd MMM yyyy")</td>
                        <td>@ev.Location</td>
                        <td><span class="badge bg-info text-dark">@ev.CategoryCount</span></td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@ev.EventId" class="btn btn-sm btn-outline-secondary">
                                Edit
                            </a>
                            <form asp-action="Delete" asp-route-id="@ev.EventId" method="post" class="d-inline"
                                  onsubmit="return confirm('Delete this event? This cannot be undone.');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                            <a asp-controller="Categories" asp-action="Manage" asp-route-eventId="@ev.EventId" class="btn btn-sm btn-outline-primary">
                                Categories
                            </a>
                            <a asp-controller="Enrolments" asp-action="ManageEnrolments" asp-route-eventId="@ev.EventId" class="btn btn-sm btn-outline-info">
                                Enrolments
                            </a>
                            <a asp-controller="Results" asp-action="ManageResults" asp-route-eventId="@ev.EventId" class="btn btn-sm btn-outline-warning">
                                Results
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}