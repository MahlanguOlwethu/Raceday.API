@model RaceDay.MVC.ViewModels.EventDetailsViewModel
@{
    ViewData["Title"] = Model.Name;
}

<div class="row mt-4">
    <div class="col-md-8">
        <h2>@Model.Name</h2>
        <p class="lead">@Model.Description</p>

        <ul class="list-group mb-4">
            <li class="list-group-item"><strong>Date:</strong> @Model.EventDate.ToString("dd MMM yyyy HH:mm")</li>
            <li class="list-group-item"><strong>Location:</strong> @Model.Location</li>
            <li class="list-group-item"><strong>Distance:</strong> @Model.DistanceKm km</li>
            <li class="list-group-item"><strong>Type:</strong> @Model.EventType</li>
        </ul>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">Available Categories</h4>
            </div>
            <div class="card-body">
                @if (Model.Categories.Any())
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var cat in Model.Categories)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <strong>@cat.Name</strong><br />
                                    <small>@cat.CategoryType</small>
                                </div>
                                <form asp-controller="Enrolments" asp-action="Enrol" method="post">
                                    <input type="hidden" name="eventId" value="@Model.EventId" />
                                    <input type="hidden" name="categoryId" value="@cat.CategoryId" />
                                    <button type="submit" class="btn btn-sm btn-success">Enrol</button>
                                </form>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted">No categories available yet.</p>
                }
            </div>
        </div>
    </div>
</div>