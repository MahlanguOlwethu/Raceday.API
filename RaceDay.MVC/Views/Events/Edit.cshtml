@model RaceDay.MVC.ViewModels.EditEventViewModel
@{
    ViewData["Title"] = "Edit Event";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-8">
        <div class="card shadow">
            <div class="card-header bg-primary text-white">
                <h3 class="mb-0">Edit Event</h3>
            </div>
            <div class="card-body">
                <!-- ENCTYPE IS CRUCIAL FOR FILE UPLOADS -->
                <form asp-action="Edit" method="post" enctype="multipart/form-data">
                    <input type="hidden" asp-for="EventId" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="form-group mb-3">
                        <label asp-for="Name" class="form-label">Event Name</label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Description" class="form-label">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 form-group mb-3">
                            <label asp-for="EventDate" class="form-label">Date and Time</label>
                            <input asp-for="EventDate" type="datetime-local" class="form-control" />
                            <span asp-validation-for="EventDate" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 form-group mb-3">
                            <label asp-for="Location" class="form-label">Location</label>
                            <input asp-for="Location" class="form-control" />
                            <span asp-validation-for="Location" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 form-group mb-3">
                            <label asp-for="DistanceKm" class="form-label">Total Distance (km)</label>
                            <input asp-for="DistanceKm" type="number" step="0.1" class="form-control" />
                            <span asp-validation-for="DistanceKm" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 form-group mb-3">
                            <label asp-for="EventType" class="form-label">Event Type</label>
                            <select asp-for="EventType" class="form-select">
                                <option value="Run">Run</option>
                                <option value="Walk">Walk</option>
                                <option value="Cycle">Cycle</option>
                            </select>
                            <span asp-validation-for="EventType" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-group mb-4">
                        @if (!string.IsNullOrEmpty(Model.ExistingBannerUrl))
                        {
                            <img src="@Model.ExistingBannerUrl" alt="Current banner" class="img-fluid rounded mb-2" style="max-height: 160px;" />
                        }
                        <label asp-for="BannerImage" class="form-label">Replace Banner Image (Optional)</label>
                        <input asp-for="BannerImage" type="file" class="form-control" accept="image/*" />
                        <span asp-validation-for="BannerImage" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-success w-100">Save Changes</button>
                    <a asp-action="MyEvents" class="btn btn-link w-100 mt-2">Back to My Events</a>
                </form>
            </div>
        </div>
    </div>
</div>